# Скопіюйте цей файл у .env і за потреби змініть значення:
#   cp .env.example .env
# Файл .env не потрапляє в git, секрети тримайте тільки в ньому.

# --- База даних (PostgreSQL) ---
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_DB=taskmanager

# --- API ---
# Для запуску поза Docker (з хоста) хост БД буде localhost, а не db
DATABASE_URL=postgresql://taskmanager:taskmanager@db:5432/taskmanager

# Секрет для підпису JWT. Згенерувати: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Адреси фронтенду, яким дозволено звертатися до API (через кому)
CORS_ORIGINS=http://localhost:3000

# --- Фронтенд ---
# Адреса API, яку бачить браузер. Вшивається під час збірки образу,
# тож після зміни виконайте: docker compose up --build
NEXT_PUBLIC_API_URL=http://localhost:8000
